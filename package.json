{
  "name": "updeck",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": "Bakari Mustafa",
  "homepage": "https://github.com/realbakari/UpDeck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realbakari/UpDeck.git"
  },
  "bugs": "https://github.com/realbakari/UpDeck/issues",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:extension": "playwright test --config playwright.extension.config.ts",
    "format": "prettier --write src tests scripts *.json *.ts *.md *.html",
    "check": "npm run test && npm run build",
    "release": "npm run check && node scripts/release.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "prettier": "3.9.9",
    "sharp": "^0.35.5",
    "simple-icons": "16.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
